{"version":21,"variables":[],"tiles":{"0":{"type":"markdown","content":"# Bindplane OTel Collector Fleet\n_Live health, throughput, and resource usage for every Bindplane OpenTelemetry collector reporting to this environment._"},"1":{"type":"markdown","content":"---\n## Overview — Fleet Health at a Glance"},"2":{"title":"🖥️ Active Collectors","description":"Distinct collector hosts that reported in the last hour. Red = none reporting.","type":"data","query":"timeseries uptime = sum(otelcol_process_uptime), by:{host.name}, from:now()-1h\n| summarize `Active Collectors` = countDistinct(host.name)","visualization":"singleValue","visualizationSettings":{"autoSelectVisualization":false,"singleValue":{"labelMode":"none","label":"Active Collectors","recordField":"Active Collectors","prefixIcon":"ContainerIcon","colorThresholdTarget":"background","sparklineSettings":{"isVisible":false},"trend":{"isVisible":false}},"coloring":{"colorRules":[{"colorMode":"custom-color","comparator":"≥","customColor":{"Default":"var(--dt-colors-charts-status-critical-default, #c4233b)"},"field":"Active Collectors","value":0,"type":"double"},{"colorMode":"custom-color","comparator":"≥","customColor":{"Default":"var(--dt-colors-charts-status-ideal-default, #2f6863)"},"field":"Active Collectors","value":1,"type":"double"}]}},"querySettings":{"defaultSamplingRatio":10,"defaultScanLimitGbytes":500,"enableSampling":false,"maxResultMegaBytes":100,"maxResultRecords":1000},"davis":{"enabled":false,"davisVisualization":{"isAvailable":true}},"timeframe":{"tileTimeframeEnabled":true,"tileTimeframe":{"from":"now()-1h","to":"now()"}}},"3":{"title":"📶 Fleet Availability % (24h)","description":"% of 5-minute intervals in the last 24h where each collector reported a heartbeat, averaged across the fleet. Green ≥99.9%, yellow ≥99.0%, red below.","type":"data","query":"timeseries c = count(otelcol_process_uptime), by:{host.name}, interval:5m, from:now()-24h\n| fieldsAdd reporting = arraySize(arrayRemoveNulls(c)), total = arraySize(c)\n| summarize `Fleet Availability %` = round(sum(reporting) * 100.0 / sum(total), decimals:1)","visualization":"singleValue","visualizationSettings":{"autoSelectVisualization":false,"singleValue":{"labelMode":"none","label":"Fleet Availability %","recordField":"Fleet Availability %","prefixIcon":"ServiceLevelObjectivesIcon","colorThresholdTarget":"background","sparklineSettings":{"isVisible":false},"trend":{"isVisible":false}},"coloring":{"colorRules":[{"colorMode":"custom-color","comparator":"≥","customColor":{"Default":"var(--dt-colors-charts-status-critical-default, #c4233b)"},"field":"Fleet Availability %","value":0,"type":"double"},{"colorMode":"custom-color","comparator":"≥","customColor":{"Default":"var(--dt-colors-charts-status-warning-default, #eca440)"},"field":"Fleet Availability %","value":99,"type":"double"},{"colorMode":"custom-color","comparator":"≥","customColor":{"Default":"var(--dt-colors-charts-status-ideal-default, #2f6863)"},"field":"Fleet Availability %","value":99.9,"type":"double"}]},"unitsOverrides":[{"identifier":"Fleet Availability %","unitCategory":"percentage","baseUnit":"percent","displayUnit":null,"decimals":1,"suffix":"","delimiter":false,"cascade":null,"added":1785439965773}]},"querySettings":{"defaultSamplingRatio":10,"defaultScanLimitGbytes":500,"enableSampling":false,"maxResultMegaBytes":100,"maxResultRecords":1000},"davis":{"enabled":false,"davisVisualization":{"isAvailable":true}},"timeframe":{"tileTimeframeEnabled":true,"tileTimeframe":{"from":"now()-24h","to":"now()"}}},"4":{"title":"📊 Metric Points Accepted % (1h)","description":"Share of received metric points accepted vs. refused by the receiver, last 1h. Green ≥99.9%, yellow ≥99.0%, red below.","type":"data","query":"timeseries acceptedMetricPoints = sum(otelcol_receiver_accepted_metric_points, scalar: true), refusedMetricPoints = sum(otelcol_receiver_refused_metric_points, scalar: true), from:now()-1h\n| fieldsAdd `Metric Points Accepted %` = if(acceptedMetricPoints + refusedMetricPoints == 0, 100.0, else: round(acceptedMetricPoints * 100.0 / (acceptedMetricPoints + refusedMetricPoints), decimals:1))\n| fields `Metric Points Accepted %`","visualization":"singleValue","visualizationSettings":{"autoSelectVisualization":false,"singleValue":{"labelMode":"none","label":"Metric Points Accepted %","recordField":"Metric Points Accepted %","prefixIcon":"BarChartIcon","colorThresholdTarget":"background","sparklineSettings":{"isVisible":false},"trend":{"isVisible":false}},"coloring":{"colorRules":[{"colorMode":"custom-color","comparator":"≥","customColor":{"Default":"var(--dt-colors-charts-status-critical-default, #c4233b)"},"field":"Metric Points Accepted %","value":0,"type":"double"},{"colorMode":"custom-color","comparator":"≥","customColor":{"Default":"var(--dt-colors-charts-status-warning-default, #eca440)"},"field":"Metric Points Accepted %","value":99,"type":"double"},{"colorMode":"custom-color","comparator":"≥","customColor":{"Default":"var(--dt-colors-charts-status-ideal-default, #2f6863)"},"field":"Metric Points Accepted %","value":99.9,"type":"double"}]},"unitsOverrides":[{"identifier":"Metric Points Accepted %","unitCategory":"percentage","baseUnit":"percent","displayUnit":null,"decimals":1,"suffix":"","delimiter":false,"cascade":null,"added":1785439965774}]},"querySettings":{"defaultSamplingRatio":10,"defaultScanLimitGbytes":500,"enableSampling":false,"maxResultMegaBytes":100,"maxResultRecords":1000},"davis":{"enabled":false,"davisVisualization":{"isAvailable":true}},"timeframe":{"tileTimeframeEnabled":true,"tileTimeframe":{"from":"now()-1h","to":"now()"}}},"5":{"title":"📄 Log Records Accepted % (1h)","description":"Share of received log records accepted vs. refused by the receiver, last 1h. Green ≥99.9%, yellow ≥99.0%, red below.","type":"data","query":"timeseries acceptedLogRecords = sum(otelcol_receiver_accepted_log_records, scalar: true), refusedLogRecords = sum(otelcol_receiver_refused_log_records, scalar: true), from:now()-1h\n| fieldsAdd `Log Records Accepted %` = if(acceptedLogRecords + refusedLogRecords == 0, 100.0, else: round(acceptedLogRecords * 100.0 / (acceptedLogRecords + refusedLogRecords), decimals:1))\n| fields `Log Records Accepted %`","visualization":"singleValue","visualizationSettings":{"autoSelectVisualization":false,"singleValue":{"labelMode":"none","label":"Log Records Accepted %","recordField":"Log Records Accepted %","prefixIcon":"LogsIcon","colorThresholdTarget":"background","sparklineSettings":{"isVisible":false},"trend":{"isVisible":false}},"coloring":{"colorRules":[{"colorMode":"custom-color","comparator":"≥","customColor":{"Default":"var(--dt-colors-charts-status-critical-default, #c4233b)"},"field":"Log Records Accepted %","value":0,"type":"double"},{"colorMode":"custom-color","comparator":"≥","customColor":{"Default":"var(--dt-colors-charts-status-warning-default, #eca440)"},"field":"Log Records Accepted %","value":99,"type":"double"},{"colorMode":"custom-color","comparator":"≥","customColor":{"Default":"var(--dt-colors-charts-status-ideal-default, #2f6863)"},"field":"Log Records Accepted %","value":99.9,"type":"double"}]},"unitsOverrides":[{"identifier":"Log Records Accepted %","unitCategory":"percentage","baseUnit":"percent","displayUnit":null,"decimals":1,"suffix":"","delimiter":false,"cascade":null,"added":1785439965774}]},"querySettings":{"defaultSamplingRatio":10,"defaultScanLimitGbytes":500,"enableSampling":false,"maxResultMegaBytes":100,"maxResultRecords":1000},"davis":{"enabled":false,"davisVisualization":{"isAvailable":true}},"timeframe":{"tileTimeframeEnabled":true,"tileTimeframe":{"from":"now()-1h","to":"now()"}}},"6":{"title":"🗂️ Collector Health by Host","description":"Per-host heartbeat availability, peak memory, and average CPU over the last 7 days. Availability % colored green ≥99.9%, yellow ≥99.0%, red below.","type":"data","query":"timeseries c = count(otelcol_process_uptime), mem = max(otelcol_process_memory_rss), cpu = avg(otelcol_process_cpu_seconds), by:{host.name}, interval:1h, from:now()-7d\n| fieldsAdd `Availability % (7d)` = round(arraySize(arrayRemoveNulls(c)) * 100.0 / arraySize(c), decimals:1), `Peak Memory RSS (bytes)` = arrayMax(mem), `Avg CPU (s)` = arrayAvg(cpu)\n| fields host.name, `Availability % (7d)`, `Peak Memory RSS (bytes)`, `Avg CPU (s)`","visualization":"table","visualizationSettings":{"coloring":{"colorRules":[{"colorMode":"custom-color","comparator":"≥","customColor":{"Default":"var(--dt-colors-charts-status-critical-default, #c4233b)"},"field":"Availability % (7d)","metadata":{"applyTo":"cell","fields":["Availability % (7d)"]},"value":0,"type":"double"},{"colorMode":"custom-color","comparator":"≥","customColor":{"Default":"var(--dt-colors-charts-status-warning-default, #eca440)"},"field":"Availability % (7d)","metadata":{"applyTo":"cell","fields":["Availability % (7d)"]},"value":99,"type":"double"},{"colorMode":"custom-color","comparator":"≥","customColor":{"Default":"var(--dt-colors-charts-status-ideal-default, #2f6863)"},"field":"Availability % (7d)","metadata":{"applyTo":"cell","fields":["Availability % (7d)"]},"value":99.9,"type":"double"}]},"autoSelectVisualization":false},"querySettings":{"maxResultRecords":1000,"defaultScanLimitGbytes":500,"maxResultMegaBytes":100,"defaultSamplingRatio":10,"enableSampling":false},"davis":{"enabled":false,"davisVisualization":{"isAvailable":true}},"timeframe":{"tileTimeframeEnabled":true,"tileTimeframe":{"from":"now()-7d","to":"now()"}}},"7":{"type":"markdown","content":"---\n## 📈 Telemetry Throughput — Sent vs. Failed"},"8":{"title":"📊 Metric Points: Sent vs Failed","type":"data","query":"timeseries sent = sum(otelcol_exporter_sent_metric_points), failed = sum(otelcol_receiver_failed_metric_points), by:{host.name}","visualization":"lineChart","visualizationSettings":{"autoSelectVisualization":false},"querySettings":{"maxResultRecords":1000,"defaultScanLimitGbytes":500,"maxResultMegaBytes":100,"defaultSamplingRatio